<module name="tablenine">
  <bean name="EffectRow">
    <var name="id" type="string"/>
    <var name="container_type" type="string"/>
    <var name="state" type="string"/>
    <var name="json" type="string"/>
    <var name="design_text" type="string"/>
  </bean>

  <bean name="CardRow">
    <var name="def_id" type="string"/>
    <var name="display_name" type="string"/>
    <var name="kind" type="string"/>
    <var name="rarity" type="string"/>
    <var name="price" type="int"/>
    <var name="level" type="int"/>
    <var name="is_elite" type="bool"/>
    <var name="is_boss" type="bool"/>
    <var name="is_reserve" type="bool"/>
    <var name="deck_id" type="string"/>
    <var name="max_hp" type="int"/>
    <var name="attack" type="int"/>
    <var name="armor" type="int"/>
    <var name="recovery" type="int"/>
    <var name="tags" type="string"/>
    <var name="effect_ids" type="string"/>
    <var name="skill_ids" type="string"/>
  </bean>

  <bean name="SkillRow">
    <var name="def_id" type="string"/>
    <var name="display_name" type="string"/>
    <var name="container_type" type="string"/>
    <var name="design_text" type="string"/>
    <var name="effect_ids" type="string"/>
  </bean>

  <bean name="RelicRow">
    <var name="def_id" type="string"/>
    <var name="display_name" type="string"/>
    <var name="rarity" type="string"/>
    <var name="design_text" type="string"/>
    <var name="tags" type="string"/>
    <var name="effect_ids" type="string"/>
  </bean>

  <bean name="RewardPoolRow">
    <var name="id" type="string"/>
    <var name="pick_count" type="int"/>
  </bean>

  <bean name="RewardEntryRow">
    <var name="id" type="string"/>
    <var name="pool_id" type="string"/>
    <var name="def_id" type="string"/>
    <var name="kind" type="string"/>
    <var name="weight" type="int"/>
    <var name="count" type="int"/>
  </bean>

  <bean name="MonsterDeckRow">
    <var name="id" type="string"/>
    <var name="display_name" type="string"/>
    <var name="kind" type="string"/>
    <var name="monster_def_ids" type="string"/>
  </bean>

  <bean name="NodeDeckRuleRow">
    <var name="node_index" type="int"/>
    <var name="total_monster_count" type="int"/>
    <var name="level1_min" type="int"/>
    <var name="level1_max" type="int"/>
    <var name="level2_min" type="int"/>
    <var name="level2_max" type="int"/>
    <var name="level3_min" type="int"/>
    <var name="level3_max" type="int"/>
    <var name="elite_count" type="int"/>
    <var name="boss_count" type="int"/>
    <var name="deck_kind" type="string"/>
  </bean>

  <bean name="RoomRow">
    <var name="kind" type="string"/>
    <var name="display_name" type="string"/>
    <var name="weight" type="int"/>
    <var name="gold_delta" type="int"/>
    <var name="max_hp_delta" type="int"/>
    <var name="heal_to_full" type="bool"/>
    <var name="reward_pool_id" type="string"/>
    <var name="shop_offer_count" type="int"/>
  </bean>

  <bean name="EconomyRow">
    <var name="id" type="string"/>
    <var name="monster_removed_gold" type="int"/>
    <var name="unused_help_card_gold" type="int"/>
    <var name="skip_help_choice_gold" type="int"/>
    <var name="skip_relic_choice_gold" type="int"/>
    <var name="discard_relic_gold" type="int"/>
    <var name="shop_delete_help_card_gold" type="int"/>
  </bean>

  <table name="TbEffect" value="EffectRow" input="*@effects.json" index="id"/>
  <table name="TbCard" value="CardRow" input="*@cards.json" index="def_id"/>
  <table name="TbSkill" value="SkillRow" input="*@skills.json" index="def_id"/>
  <table name="TbRelic" value="RelicRow" input="*@relics.json" index="def_id"/>
  <table name="TbRewardPool" value="RewardPoolRow" input="*@reward_pools.json" index="id"/>
  <table name="TbRewardEntry" value="RewardEntryRow" input="*@reward_entries.json" index="id"/>
  <table name="TbMonsterDeck" value="MonsterDeckRow" input="*@monster_decks.json" index="id"/>
  <table name="TbNodeDeckRule" value="NodeDeckRuleRow" input="*@node_deck_rules.json" index="node_index"/>
  <table name="TbRoom" value="RoomRow" input="*@rooms.json" index="kind"/>
  <table name="TbEconomy" value="EconomyRow" input="*@economy.json" index="id"/>
</module>
