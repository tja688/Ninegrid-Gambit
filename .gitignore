# This .gitignore file should be used with a Unity project.
# From: https://github.com/github/gitignore/blob/main/Unity.gitignore

# Autogenerated Coverage
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/[Aa]sset[Ss]tore[Tt]ools*

# Autogenerated Coverage
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory (Unity 2019.3+)
.gradle/

# Autogenerated VS/MD/CS solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/

# OS-specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.idea/
*.iml

# Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/

# Memory capture
/[Mm]emoryCaptures/

# Recordings
/[Aa]ssets/[Ss]treamingAssets/Recordings/

# Asset Store tools
/[Aa]ssets/[Aa]sset[Ss]tore[Tt]ools*

# Visual Studio cache directory
.vs/

# Plastic SCM
*.ignore
*.orig
